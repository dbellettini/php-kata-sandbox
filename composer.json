{
    "name": "dbellettini/kata-sandbox",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "tdd",
        "phpunit"
    ],
    "authors": [
        {
            "name": "Davide Bellettini",
            "email": "davide.bellettini@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.49",
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Kata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kata\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    }
}
